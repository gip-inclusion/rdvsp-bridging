<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Pont RDV · admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "stylesheets/app", "pont-rdv" %>
    <%= javascript_include_tag "copy", defer: true %>
  </head>
  <body>
    <header class="pont-header" role="banner">
      <div class="container pont-header__row">
        <%= link_to admin_root_path, class: "pont-brand" do %>
          <span class="pont-brand__mark"><i class="ri-arrow-left-right-line" aria-hidden="true"></i></span>
          <span><span class="pont-brand__name">Pont RDV</span><span class="pont-brand__tag">Administration</span></span>
        <% end %>
        <nav class="pont-header__nav" aria-label="Navigation principale">
          <%= link_to admin_root_path, class: "btn btn-outline-primary btn-ico bg-white" do %>
            <i class="ri-building-line" aria-hidden="true"></i><span class="d-none d-sm-inline">Comptes</span>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="s-main" role="main">
      <% messages = flash.to_h.except("password") %>
      <% if messages.any? %>
        <div class="container pont-flashes">
          <% messages.each do |type, message| %>
            <div class="alert <%= type == "alert" ? "alert-danger" : "alert-success" %>" role="status">
              <p class="mb-0"><%= message %></p>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
