<p class="fs-sm text-muted mb-1">Pont RDV · <%= @partner_link.account.name %></p>
<h1 class="h2">Administrer « <%= @partner_link.account.name %> »</h1>
<p>
  Ce lien ouvre la page de votre compte dans Pont RDV : connecter vos utilisateurs Pipedrive, envoyer à chaque agent
  le lien de son agenda, régler les options.
</p>
<%= button_to partner_link_path(params[:token]),
              class: "btn btn-primary btn-lg btn-block btn-ico justify-content-center mt-4" do %>
  <i class="ri-arrow-right-line" aria-hidden="true"></i><span>Continuer</span>
<% end %>
<p class="fs-sm text-muted mt-3 mb-0">
  Gardez ce lien pour vous : il donne accès à votre compte sans mot de passe.
</p>
