<h1><%= @connection.provider_user_name || @connection.provider_user_id %></h1>
<p class="muted"><%= link_to @connection.account.name, admin_account_path(@connection.account) %> · agent RDV-SP : <%= @connection.agent_email || "?" %></p>

<h2>Identifiants à saisir dans RDV Service Public</h2>
<p>Dans RDV Service Public : <em>Synchronisation d’agenda → Connecter mon agenda via Caldav</em>.</p>
<table>
  <tr><th>Identifiant</th><td><code><%= @connection.username %></code></td></tr>
  <tr><th>Mot de passe</th><td>
    <% if @password %>
      <code><%= @password %></code> <span class="ko">(affiché une seule fois)</span>
    <% else %>
      <span class="muted">masqué</span> — <%= button_to "Générer un nouveau mot de passe", reset_password_admin_connection_path(@connection), form_class: "inline", data: { turbo: false } %>
    <% end %>
  </td></tr>
  <tr><th>URL de l’agenda</th><td><code><%= "#{Rails.configuration.x.base_url}#{@connection.calendar_path}" %></code></td></tr>
</table>

<h2>État</h2>
<p>
  Dernier passage de RDV-SP : <%= @connection.last_seen_at ? "il y a #{time_ago_in_words(@connection.last_seen_at)}" : "jamais" %> ·
  dernière reconstruction : <%= @connection.rebuilt_at ? "il y a #{time_ago_in_words(@connection.rebuilt_at)}" : "jamais" %> ·
  <%= @connection.busy_blocks.live.count %> occupations ·
  <%= @connection.rdvs.where(state: "failed").count %> RDV en échec
  <%= button_to "Reconstruire", rebuild_admin_connection_path(@connection), form_class: "inline" %>
</p>

<h2>Rendez-vous reçus de RDV-SP</h2>
<p>
  transmis : <%= @connection.rdvs.transmitted.count %> ·
  ignorés : <%= @connection.rdvs.ignored.count %> (déjà pris avant la connexion) ·
  en échec : <%= @connection.rdvs.where(state: "failed").count %> ·
  annulés : <%= @connection.rdvs.cancelled.count %>
</p>
<p class="muted">
  <% if @connection.baseline_started_at %>
    Dernier test de connexion par RDV-SP : <%= paris_time(@connection.baseline_started_at) %> ;
    <%= @connection.rdvs.ignored.where(created_at: @connection.baseline_started_at..@connection.baseline_until).count %>
    RDV existants reçus et ignorés jusqu’à <%= paris_time(@connection.baseline_until) %>.
  <% else %>
    Aucun test de connexion par RDV-SP enregistré depuis que la passerelle ignore les RDV existants.
  <% end %>
  <% if @connection.baseline_max_rdvsp_id %>
    Les RDV de numéro RDV-SP inférieur ou égal à <%= @connection.baseline_max_rdvsp_id %> reçus plus tard sont ignorés aussi.
  <% end %>
</p>
<p><%= link_to "Ignorer les RDV reçus avant…", new_admin_connection_ignored_rdv_path(@connection) %></p>
<% if @rdvs.any? %>
  <table>
    <tr><th>Reçu le</th><th>Début</th><th>N° RDV-SP</th><th>État</th><th></th></tr>
    <% @rdvs.each do |rdv| %>
      <tr>
        <td><%= paris_time(rdv.created_at) %></td>
        <td><%= paris_time(rdv.starts_at) %></td>
        <td><%= rdv.rdvsp_id || "?" %></td>
        <td><%= rdv_status(rdv) %></td>
        <td>
          <% if rdv.ignored? %>
            <%= button_to "Transmettre quand même", release_admin_rdv_path(rdv), form_class: "inline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>

<h2>Options</h2>
<%= form_with model: @connection, url: admin_connection_path(@connection) do |f| %>
  <label>E-mail de l’agent <%= f.email_field :agent_email, size: 40 %></label>
  <label><%= f.check_box :include_all_day %> Les activités sans heure bloquent toute la journée</label>
  <%= f.submit "Enregistrer" %>
<% end %>
