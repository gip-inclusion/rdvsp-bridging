<%= render "admin/title", title: "Connecter un compte Pipedrive", back: ["Comptes", admin_root_path] %>

<section class="s-section">
  <div class="s-section__container container">
    <div class="s-section__row row">
      <div class="s-section__col col-12 col-lg-8">
        <div class="c-box">
          <p>Clé d’API d’un administrateur de l’entreprise (Pipedrive → Préférences personnelles → API).</p>
          <%= form_with url: admin_accounts_path do |f| %>
            <%= f.label :api_token, "Clé d’API", class: "form-label" %>
            <%= f.password_field :api_token, required: true, class: "form-control mb-3" %>
            <%= f.label :alert_email, "E-mail de l’administrateur côté partenaire (alertes)", class: "form-label" %>
            <%= f.email_field :alert_email, class: "form-control mb-4" %>
            <div class="d-flex flex-column flex-sm-row gap-2">
              <%= f.submit "Connecter", class: "btn btn-primary" %>
              <%= link_to "Annuler", admin_root_path, class: "btn btn-link" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
