<% authorization = account.rdvsp_authorization %>
<div class="c-box mb-3 mb-md-4">
  <h2 class="h3">RDV Service Public</h2>
  <% if authorization %>
    <% if authorization.lost? %>
      <div class="alert alert-danger" role="status">
        <p class="mb-0">Perdue le <%= paris_time(authorization.lost_at) %> : envoyez un nouveau lien.</p>
      </div>
    <% end %>
    <ul class="list-data mb-3">
      <li>
        <small>Autorisée par l’agent</small>
        <strong><%= authorization.agent_email || "n° #{authorization.agent_id}" %>, le <%= paris_time(authorization.created_at) %></strong>
      </li>
      <li>
        <small>Organisation où « Prendre RDV » crée les usagers</small>
        <% if account.rdvsp_organisation_id %>
          <strong>n° <%= account.rdvsp_organisation_id %></strong>
        <% else %>
          <strong>pas encore choisie</strong>
          <span class="fs-sm text-muted">À défaut, celle de l’agent s’il n’en a qu’une.</span>
        <% end %>
        <% unless authorization.lost? %>
          <%= link_to "Changer", edit_admin_account_rdvsp_organisation_path(account), class: "btn-link fs-sm ms-2" %>
        <% end %>
      </li>
    </ul>
    <div class="d-flex flex-column flex-sm-row gap-2 mb-4">
      <% unless authorization.lost? %>
        <%= link_to new_admin_account_usager_import_path(account), class: "btn btn-primary btn-sm btn-ico" do %>
          <i class="ri-upload-2-line" aria-hidden="true"></i><span>Importer des bénéficiaires</span>
        <% end %>
      <% end %>
      <%= button_to admin_account_rdvsp_authorization_path(account), method: :delete,
                    class: "btn btn-outline-danger btn-sm btn-ico",
                    form: { onsubmit: "return confirm('Retirer l’autorisation RDV-SP ?')" } do %>
        <i class="ri-delete-bin-line" aria-hidden="true"></i><span>Retirer l’autorisation</span>
      <% end %>
    </div>
  <% else %>
    <p>Aucun agent n’a encore autorisé la passerelle à utiliser l’API de RDV-SP.</p>
  <% end %>

  <label class="form-label" for="rdvsp-authorization-link">
    Lien d’autorisation à envoyer à un agent RDV-SP du partenaire <span class="text-muted">(valable 7 jours)</span>
  </label>
  <%= copy_field "rdvsp-authorization-link",
                 "#{Rails.configuration.x.base_url}#{rdvsp_authorization_link_path(RdvspAuthorization.link_token(account))}" %>

  <% if account.usager_imports.any? %>
    <h3 class="h5 mt-4">Imports de bénéficiaires</h3>
    <ul class="list-group list-group-flush pont-rows">
      <% account.usager_imports.order(created_at: :desc).each do |usager_import| %>
        <li class="list-group-item px-0 d-flex flex-column flex-sm-row gap-2 justify-content-between">
          <div>
            <strong><%= paris_time(usager_import.created_at) %></strong>
            <span class="fs-sm text-muted">· organisation n° <%= usager_import.rdvsp_organisation_id %></span>
            <div class="fs-sm text-muted"><%= usager_import_summary(usager_import) %></div>
            <% if usager_import.error %><div class="fs-sm text-danger"><%= usager_import.error %></div><% end %>
          </div>
          <div><%= usager_import_badge(usager_import) %></div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h3 class="h5 mt-4">Bouton « Prendre RDV »</h3>
  <p class="fs-sm text-muted">Chaque agent autorise Pont RDV à son premier clic, pour agir en son nom.</p>
  <% agent_authorizations = account.rdvsp_agent_authorizations.order(:created_at) %>
  <% if agent_authorizations.any? %>
    <% names = account.connections.pluck(:provider_user_id, :provider_user_name).to_h %>
    <ul class="list-group list-group-flush pont-rows">
      <% agent_authorizations.each do |agent_authorization| %>
        <li class="list-group-item px-0 d-flex gap-2 justify-content-between align-items-center">
          <div class="text-break">
            <strong>
              <%= names[agent_authorization.provider_user_id] ||
                    "Utilisateur Pipedrive n° #{agent_authorization.provider_user_id}" %>
            </strong>
            <div class="fs-sm text-muted">
              <%= agent_authorization.agent_email || "agent n° #{agent_authorization.agent_id}" %>
              · le <%= paris_time(agent_authorization.created_at) %>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <% if agent_authorization.lost? %><%= badge("Perdue", :danger) %><% end %>
            <%= button_to admin_account_rdvsp_agent_authorization_path(account, agent_authorization), method: :delete,
                          class: "btn btn-outline-danger btn-sm btn-ico", "aria-label": "Retirer",
                          form: { onsubmit: "return confirm('Retirer l’autorisation de cet agent ?')" } do %>
              <i class="ri-delete-bin-line" aria-hidden="true"></i>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-0">Aucun agent pour l’instant.</p>
  <% end %>
</div>
