<% before = @before.in_time_zone(Admin::IgnoredRdvsController::PARIS).strftime("%Y-%m-%dT%H:%M:%S") %>
<% name = @connection.provider_user_name || @connection.provider_user_id %>
<%= render "admin/title", title: "Ignorer des RDV existants", back: [name, admin_connection_path(@connection)],
                          subtitle: "Agent RDV-SP : #{@connection.agent_email || '?'}" %>

<section class="s-section">
  <div class="s-section__container container">
    <div class="s-section__row row">
      <div class="s-section__col col-12 col-lg-8">
        <div class="c-box mb-3 mb-md-4">
          <p>
            Les RDV reçus avant cette heure seront ignorés : la passerelle supprime les activités qu’elle a créées pour
            eux et ne les transmettra plus, même s’ils sont modifiés ou annulés dans RDV-SP. Les copies faites par
            l’agent ne sont pas touchées.
          </p>
          <%= form_with url: new_admin_connection_ignored_rdv_path(@connection), method: :get do |f| %>
            <%= f.label :before, "Reçus avant (heure de Paris)", class: "form-label" %>
            <%= f.datetime_local_field :before, value: before, step: 1, class: "form-control mb-3" %>
            <%= f.submit "Prévisualiser", name: nil, class: "btn btn-outline-primary" %>
          <% end %>
        </div>
        <div class="c-box">
          <h2 class="h3"><%= count_label(@rdvs.size, "RDV concerné", "RDV concernés") %></h2>
          <% if @rdvs.any? %>
            <ul class="list-group list-group-flush pont-rows mb-4">
              <% @rdvs.each do |rdv| %>
                <li class="list-group-item px-0 d-flex gap-3 justify-content-between align-items-start">
                  <div>
                    <strong><%= paris_time(rdv.starts_at) %></strong>
                    <div class="fs-sm text-muted">
                      RDV n° <%= rdv.rdvsp_id || "?" %> · reçu le <%= paris_time(rdv.created_at) %> ·
                      activité créée : <%= rdv.provider_object_id ? "oui, à supprimer" : "non" %>
                    </div>
                  </div>
                  <%= rdv_badge(rdv) %>
                </li>
              <% end %>
            </ul>
            <%= button_to "Ignorer ces #{@rdvs.size} RDV", admin_connection_ignored_rdvs_path(@connection),
                          params: { before: }, class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
